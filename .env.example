# Optional RapidAPI key for JSearch (Google for Jobs: Indeed, LinkedIn, etc.)
# Without it, Stackhunt still searches The Muse, Remotive, Arbeitnow,
# Jobicy, and public Greenhouse boards.
RAPIDAPI_KEY=

# Places API (New) + Geocoding API + Routes API.
# Restrict the key to those three APIs. Autocomplete uses Places;
# commute uses Geocoding (job cities) and Routes (drive times).
GOOGLE_API_KEY=

PORT=3001
